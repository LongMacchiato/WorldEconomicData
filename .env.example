# ==============================================================================
# DBnomics Data Browser & DuckDB Analytics Warehouse — Environment Template
# Copy this file to `.env` in the repository root:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gemini AI Economist Assistant (Google GenAI Interactions API)
# ------------------------------------------------------------------------------
# Required to enable the In-App AI Economist Assistant (`POST /api/analytics/ai/chat`).
# Accepts GEMINI_API_KEY, DBNOMICS_BROWSER_GEMINI_API_KEY, or GOOGLE_API_KEY.
GEMINI_API_KEY=
# DBNOMICS_BROWSER_GEMINI_API_KEY=
DBNOMICS_BROWSER_GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 2. Embedded DuckDB Analytics Warehouse
# ------------------------------------------------------------------------------
# File path for the persistent DuckDB star-schema database (relative to repo root)
DBNOMICS_BROWSER_ANALYTICS_DB_PATH=data/analytics.duckdb
# Maximum rows returned by `/api/analytics/transform` and `/api/analytics/sql`
DBNOMICS_BROWSER_ANALYTICS_MAX_QUERY_ROWS=5000

# ------------------------------------------------------------------------------
# 3. Upstream DBnomics API & Caching
# ------------------------------------------------------------------------------
DBNOMICS_BROWSER_API_BASE_URL=https://api.db.nomics.world/v22
DBNOMICS_BROWSER_UPSTREAM_TIMEOUT_SECONDS=60.0
DBNOMICS_BROWSER_METADATA_CACHE_MAX_SIZE=128
DBNOMICS_BROWSER_METADATA_CACHE_TTL_SECONDS=900

# ------------------------------------------------------------------------------
# 4. Catalogue Pagination, Preview & Export Limits
# ------------------------------------------------------------------------------
DBNOMICS_BROWSER_PROVIDERS_PAGE_LIMIT=200
DBNOMICS_BROWSER_DATASETS_PAGE_LIMIT=100
DBNOMICS_BROWSER_SERIES_PAGE_LIMIT=50
DBNOMICS_BROWSER_SERIES_MAX_PAGE_LIMIT=200
DBNOMICS_BROWSER_MAX_SELECTED_SERIES=10
DBNOMICS_BROWSER_PREVIEW_DEFAULT_PAGE_SIZE=100
DBNOMICS_BROWSER_PREVIEW_MAX_PAGE_SIZE=1000
DBNOMICS_BROWSER_EXPORT_MAX_ROWS=100000

# ------------------------------------------------------------------------------
# 5. Server, CORS & Frontend Proxy (`start.sh` & Vite)
# ------------------------------------------------------------------------------
DBNOMICS_API_HOST=127.0.0.1
DBNOMICS_API_PORT=8001
DBNOMICS_OPEN_BROWSER=1
# JSON array of allowed CORS origins for the FastAPI backend
DBNOMICS_BROWSER_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","http://localhost:5175","http://127.0.0.1:5175"]

# Optional frontend API base URL override (leave unset in local dev to use Vite proxy)
# VITE_API_BASE_URL=http://127.0.0.1:8001

# ------------------------------------------------------------------------------
# 6. Direct Macro & Market Connectors + Apple Silicon MLX AI
# ------------------------------------------------------------------------------
# St. Louis Fed API Key for direct FRED series ingestion (T10Y2Y, GS10, WALCL, etc.)
FRED_API_KEY=
# Local Apple Silicon MLX model and Hugging Face cache directory
DBNOMICS_BROWSER_MLX_MODEL_ID=mlx-community/Meta-Llama-3.1-8B-Instruct-4bit
DBNOMICS_BROWSER_HF_CACHE_DIR=/Users/jasondavey/.cache/huggingface
